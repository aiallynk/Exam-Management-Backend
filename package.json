{
  "name": "exam-management-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend server for Exam Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "pip install -r services/omr/requirements.txt && echo 'Server build complete - ready for production'",
    "seed": "node scripts/seed.js",
    "backfill:exam-packages": "node scripts/backfillExamPackages.js",
    "backfill:question-paper-questions": "node scripts/backfillQuestionPaperQuestions.js",
    "backup:worker": "node workers/backupWorker.js",
    "backup:migrate-legacy": "node scripts/migrateLegacyBackupsToS3.js"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1093.0",
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.80.12",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "openai": "^4.20.1",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.3",
    "read-excel-file": "^5.7.1",
    "tar": "^7.5.21",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
