PORT=4000
HOST=0.0.0.0
# Offline answer-sheet page preparation. The Gemini vision model reads and
# evaluates the handwriting in every mode; this only decides how the upload
# is turned into per-page inputs.
#   VISION_DIRECT (default) — no local Python. The PDF is split into single-
#     page PDFs with pdf-lib and sent straight to Gemini. Nothing on the host
#     needs Python / PyMuPDF / OpenCV.
#   PYTHON — force the legacy PyMuPDF rasterizer (rasterized JPEG previews,
#     deskew). Requires services/offlineEvaluation/requirements.txt installed.
#   AUTO — try PYTHON, fall back to VISION_DIRECT if the interpreter or its
#     dependencies are missing.
# ANSWER_SCRIPT_NORMALIZE_MODE=VISION_DIRECT
#
# Only used when ANSWER_SCRIPT_NORMALIZE_MODE is PYTHON or AUTO. Point this at
# a venv that has services/offlineEvaluation/requirements.txt installed (at
# minimum pymupdf). Leave blank to use the system `python3`.
# OFFLINE_EVAL_PYTHON=/opt/xamigo/venv/bin/python
# HTTP keep-alive tuning. Set both ABOVE the idle timeout of any proxy/tunnel
# in front of the server (VS Code dev tunnels, Vercel, nginx, an ELB) to avoid
# intermittent 502s that surface in the browser as spurious CORS errors.
# headersTimeout must stay strictly greater than keepAliveTimeout.
SERVER_KEEPALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=66000
MONGODB_URI=mongodb+srv://<username>:<password>@<host>/<database>?retryWrites=true&w=majority
# Phase 5 E2E only. NODE_ENV=test refuses Atlas/SRV/non-local targets and
# requires this database name to begin with xamigo_phase5_e2e.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/xamigo_phase5_e2e
MONGODB_DB_NAME=exam_system
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
TOKEN_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
CORS_ORIGIN=https://exam-management-frontend-psi.vercel.app
APP_BASE_URL=https://exam-management-frontend-psi.vercel.app
FRONTEND_URL=https://exam-management-frontend-psi.vercel.app
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL=
APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna-medium
OPENAI_QUESTION_MODEL=gpt-5.6-luna-medium
OPENAI_CLASSIFICATION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=

# ==========================================================
# AI PROVIDER SECRETS — BACKEND ONLY
# ==========================================================
GEMINI_API_KEY=

# ==========================================================
# AI CONFIGURATION
# ==========================================================
# `database` loads operation routing from SystemConfig
# (`platform.ai.operationRouting`). Env defaults below are bootstrap
# fallback only when no DB record exists. Secrets always remain here.
AI_CONFIG_SOURCE=database
AI_DEFAULT_QUESTION_PROVIDER=openai
AI_DEFAULT_EVALUATION_PROVIDER=gemini

# Runtime safety
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_STRICT_PROVIDER_ROUTING=true
AI_ENABLE_PROVIDER_FALLBACK=false
AI_USE_MOCK_PROVIDERS=false

# Question-import ("Import Questions") tuning. The import pipeline fans out
# many small AI calls; these keep it fast:
#   - It runs one bulk multi-question AI call per ~12k-char window instead of
#     one call per question, and each import AI call uses a 1-retry / 45s
#     budget instead of the global AI_MAX_RETRIES / AI_REQUEST_TIMEOUT_MS.
#   - For a PDF whose embedded text layer is already strong and numbered, the
#     full-PDF AI vision pass is skipped (the deterministic parser handles it).
#     Set this to true to always run that vision pass (needed only when the
#     answer key is shown purely as a visual highlight and the text is good).
# QUESTION_IMPORT_FORCE_PDF_VISION=false
#   - Verbose per-block import logging (off unless NODE_ENV=development).
# QUESTION_IMPORT_DEBUG=false

# ==========================================================
# GEMINI MODELS (env-configurable; routing comes from DB or defaults)
# Question generation uses OpenAI (gpt-5.6-luna-medium). Evaluation + image generation use Gemini.
# ==========================================================
GEMINI_EVALUATION_MODEL=gemini-3.1-flash-lite
# Optional higher-quality tier for long/high-stakes/low-confidence subjective evaluation.
GEMINI_HIGH_ACCURACY_EVALUATION_MODEL=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_HANDWRITING_MODEL=gemini-3.1-flash-lite
GEMINI_FEEDBACK_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Deprecated legacy per-operation provider overrides (optional migration aid):
# AI_QUESTION_PROVIDER=openai
# AI_EVALUATION_PROVIDER=gemini
# AI_EMBEDDING_PROVIDER=openai
# AI_VISION_PROVIDER=gemini
# AI_HANDWRITING_PROVIDER=gemini
# AI_FORMATIVE_FEEDBACK_PROVIDER=gemini
# AI_QUESTION_IMAGE_PROVIDER=gemini
# Required before enabling Source-Grounded AI generation (SOURCE_GROUNDED_GENERATION
# capability) for any tenant — HMAC key for the cross-tenant novelty ledger.
# Not required at boot; the app runs fine without it while the feature stays
# UNRELEASED. Generate with e.g. `openssl rand -hex 32`.
NOVELTY_SIGNATURE_SECRET=change-me-too
# Optional. Improves reliability of Google Drive URL ingestion for
# Source-Grounded sources (large/binary files) via the official Drive v3
# files.get?alt=media endpoint. Not required — publicly-shared ("Anyone
# with the link") Drive files and Workspace docs/sheets/slides are still
# readable without it via their public export endpoints. Create at
# https://console.cloud.google.com/apis/credentials (API key with the
# Drive API enabled), never commit the real value.
GOOGLE_DRIVE_API_KEY=
UPLOAD_DIR=./uploads
# S3 image storage for uploads and AI-generated question diagrams, namespaced
# per tenant/exam as xamigo/tenant-{tenantId}/exams/exam-{examId}/{category}/...
# (see services/storage/imageStorage.js). Not required at boot, but image
# upload/generation endpoints hard-fail with a clear error until these are
# set. Separate from the backup-storage feature noted below, which is
# configured via Super Admin + IAM/workload identity, not env vars.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional — only for non-AWS S3-compatible providers (MinIO, R2, Spaces, etc).
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
OMR_SERVICE_URL=http://127.0.0.1:8001
OMR_SERVICE_TIMEOUT_MS=60000
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_USER=
JUDGE0_CPU_TIME_LIMIT=2
JUDGE0_WALL_TIME_LIMIT=5
JUDGE0_MEMORY_LIMIT_KB=131072
JUDGE0_ENABLE_NETWORK=false
JUDGE0_POLLING_INTERVAL_MS=1000
JUDGE0_MAX_POLLS=20
INCREMENTAL_BACKUP_ENABLED=true
INCREMENTAL_BACKUP_DIR=backups/incremental
INCREMENTAL_BACKUP_CRON_HOUR_IST=2
INCREMENTAL_BACKUP_CRON_MINUTE=15
INCREMENTAL_BACKUP_ROTATION_THRESHOLD_MB=250

# Backup storage, retention, schedules, and feature enablement are configured by
# Super Admin in the application. Do not place AWS/S3 access keys in this file.
# The separate backup worker uses the hosting platform's IAM/workload identity.
